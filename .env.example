# Environment variable NAMES used by the Local-First AI Receptionist.
# This file documents names only — never put real values in version control.
# Secrets themselves live in <state dir>/secrets.json (generated locally,
# mode 0600, by scripts/generate_secrets.py) and are NOT read from env vars.

# State root (config.json, secrets.json, state.sqlite3, quarantine/).
# Default: ~/.local/state/ai-receptionist
RECEPTIONIST_HOME=

# Explicit config path override (default: $RECEPTIONIST_HOME/config.json).
RECEPTIONIST_CONFIG=

# Test harness only: when set to 1, the test suite installs a network guard
# that fails any test attempting a non-loopback connection.
RECEPTIONIST_TEST_NETGUARD=
