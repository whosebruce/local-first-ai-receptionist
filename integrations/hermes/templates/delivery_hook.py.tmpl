"""Rendered receptionist delivery hook (generated by render_overlay.py — do
not hand-edit; re-render instead).

Consumes ONLY the additive `route` envelope carried inside the HMAC-verified
receptionist relay payload (the receptionist signs the whole body; the
gateway validates the signature BEFORE this hook sees the payload). No LLM is
involved anywhere in this path.

  * kind == "intake"   -> post the mirrored alert to the private intake
    channel (must exactly match the receptionist-configured channel ID).
  * kind == "category" -> post into the configured category channel inside a
    stable per-lead thread (reuse route.thread_id when live, else create a
    fresh thread named route.thread_name — receptionist-built, never
    containing raw identity — and rebind via callback).
  * After a successful post, HMAC-call the receptionist's
    /discord/alert-posted callback with the real message/thread IDs.
  * Missing/invalid/forged routes, unreadable config, or ANY failure before a
    post -> return None so the caller falls back to its legacy delivery (the
    alert is never lost and never reaches a contact). A callback failure
    after a successful post is logged and does not undo the delivery: the
    correlation stays pending, prunes, and later replies fail closed.

This module has no capability to message any contact.
"""
from __future__ import annotations

import hashlib
import hmac
import json
import logging
import stat
import urllib.request
from pathlib import Path
from typing import Any, Optional

logger = logging.getLogger("receptionist.delivery_hook")

RECEPTIONIST_STATE_DIR = Path("{{RECEPTIONIST_STATE_DIR}}")
CALLBACK_URL = "{{RECEPTIONIST_BASE_URL}}/discord/alert-posted"
PAYLOAD_TYPE = "receptionist.inbound"
THREAD_AUTO_ARCHIVE_MINUTES = 10080
MAX_THREAD_NAME = 100


def load_route_config() -> dict[str, Any]:
    config = json.loads((RECEPTIONIST_STATE_DIR / "config.json").read_text())
    dcfg = config.get("discord") or {}
    secrets_path = RECEPTIONIST_STATE_DIR / "secrets.json"
    if stat.S_IMODE(secrets_path.lstat().st_mode) & 0o077:
        raise PermissionError("secrets.json is group/world accessible; refusing to load")
    secrets = json.loads(secrets_path.read_text())
    return {
        "enabled": bool(dcfg.get("enabled")),
        "intake_channel_id": str(dcfg.get("intake_channel_id") or ""),
        "category_channels": {str(k): str(v) for k, v in (dcfg.get("category_channels") or {}).items()},
        "hook_secret": secrets.get("discord_hook_secret", ""),
    }


def validate_route(route: Any, cfg: dict[str, Any]) -> Optional[dict[str, Any]]:
    """Normalize and allowlist-check a route envelope. The target channel must
    EXACTLY match the receptionist-configured intake channel (kind=intake) or
    the configured channel for the named category (kind=category). Anything
    malformed, forged, or pointing at any other channel is rejected."""
    if not isinstance(route, dict):
        return None
    token = route.get("correlation_token")
    if not isinstance(token, str) or not token:
        return None
    kind = route.get("kind")
    channel_id = str(route.get("channel_id") or "")
    if not channel_id.isdigit():
        return None
    if kind == "intake":
        if not cfg["intake_channel_id"] or channel_id != cfg["intake_channel_id"]:
            return None
        return {"kind": "intake", "channel_id": channel_id, "correlation_token": token,
                "thread_id": None, "thread_name": None}
    if kind == "category":
        category = str(route.get("category") or "")
        if not category or cfg["category_channels"].get(category) != channel_id:
            return None
        thread_id = route.get("thread_id")
        thread_id = str(thread_id) if thread_id else None
        if thread_id is not None and not thread_id.isdigit():
            return None
        thread_name = str(route.get("thread_name") or "")[:MAX_THREAD_NAME]
        if not thread_id and not thread_name:
            return None
        return {"kind": "category", "channel_id": channel_id, "correlation_token": token,
                "thread_id": thread_id, "thread_name": thread_name or None}
    return None


def _post_callback(cfg: dict[str, Any], payload: dict[str, Any]) -> bool:
    raw = json.dumps(payload).encode()
    signature = hmac.new(cfg["hook_secret"].encode(), raw, hashlib.sha256).hexdigest()
    request = urllib.request.Request(
        CALLBACK_URL, data=raw,
        headers={"Content-Type": "application/json", "X-Hook-Signature": signature},
        method="POST")
    with urllib.request.urlopen(request, timeout=10) as response:
        return response.status == 200


async def _create_thread(adapter: Any, channel_id: str, thread_name: str) -> Optional[str]:
    client = getattr(adapter, "_client", None)
    if client is None:
        return None
    channel = client.get_channel(int(channel_id))
    if channel is None:
        channel = await client.fetch_channel(int(channel_id))
    if channel is None:
        return None
    thread = await channel.create_thread(
        name=thread_name, auto_archive_duration=THREAD_AUTO_ARCHIVE_MINUTES)
    tid = getattr(thread, "id", None)
    return str(tid) if tid else None


async def maybe_route_delivery(
    discord_adapter: Any,
    content: str,
    payload: dict[str, Any],
    *,
    config: Optional[dict[str, Any]] = None,
    post_callback_fn: Optional[Any] = None,
) -> Optional[Any]:
    """Returns the adapter's send result when a valid routed delivery was
    fully handled, or None when the caller must proceed with its legacy
    delivery path. Never contacts a lead."""
    try:
        if not isinstance(payload, dict) or payload.get("type") != PAYLOAD_TYPE:
            return None
        route = payload.get("route")
        if route is None:
            return None
        cfg = config or load_route_config()
        if not cfg.get("enabled") or not cfg.get("hook_secret") or not cfg.get("intake_channel_id"):
            return None
        plan = validate_route(route, cfg)
        if plan is None:
            logger.warning("invalid/forged route envelope rejected; using legacy delivery")
            return None
        if discord_adapter is None:
            return None
    except Exception:
        logger.warning("route evaluation failed; using legacy delivery", exc_info=True)
        return None

    try:
        thread_id = plan["thread_id"]
        result = None
        if plan["kind"] == "category":
            if thread_id:
                result = await discord_adapter.send(
                    plan["channel_id"], content, metadata={"thread_id": thread_id})
                if not getattr(result, "success", False):
                    thread_id = None
                    result = None
            if result is None:
                if not plan["thread_name"]:
                    return None
                thread_id = await _create_thread(discord_adapter, plan["channel_id"], plan["thread_name"])
                if not thread_id:
                    return None
                result = await discord_adapter.send(
                    plan["channel_id"], content, metadata={"thread_id": thread_id})
        else:
            result = await discord_adapter.send(plan["channel_id"], content)
        if not getattr(result, "success", False):
            return None
    except Exception:
        logger.warning("routed delivery failed before post; using legacy delivery", exc_info=True)
        return None

    try:
        poster = post_callback_fn or _post_callback
        poster(cfg, {
            "correlation_token": plan["correlation_token"],
            "message_id": getattr(result, "message_id", None),
            "channel_id": plan["channel_id"],
            "thread_id": thread_id if plan["kind"] == "category" else None,
        })
    except Exception:
        logger.warning("alert-posted callback failed (correlation stays pending)", exc_info=True)
    return result
