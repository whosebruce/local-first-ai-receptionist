"""Rendered receptionist intake hook (generated by render_overlay.py — do not
hand-edit; re-render instead).

ALL authorization, correlation, and trust-change logic lives in the isolated
receptionist service (`/discord/intake-command`). This module only:
  1. Recognizes an owner reply-with-mention in the private intake channel
     BEFORE the gateway invokes any LLM.
  2. Forwards the raw fields to the receptionist over loopback/LAN, HMAC-signed.
  3. Posts the receptionist's deterministic read-back back into intake.

If it handles a message it returns a truthy result so the caller returns
early and the model is never invoked for an intake command. It never sends
anything to a contact and never logs any credential.
"""
from __future__ import annotations

import hashlib
import hmac
import json
import logging
import stat
import urllib.request
from pathlib import Path
from typing import Any, Optional

logger = logging.getLogger("receptionist.intake_hook")

RECEPTIONIST_BASE_URL = "{{RECEPTIONIST_BASE_URL}}"
RECEPTIONIST_STATE_DIR = Path("{{RECEPTIONIST_STATE_DIR}}")
INTAKE_CHANNEL_ID = "{{INTAKE_CHANNEL_ID}}"


def _hook_secret() -> str:
    path = RECEPTIONIST_STATE_DIR / "secrets.json"
    if stat.S_IMODE(path.lstat().st_mode) & 0o077:
        raise PermissionError("secrets.json is group/world accessible; refusing to load")
    secrets = json.loads(path.read_text())
    return secrets.get("discord_hook_secret", "")


def extract_fields(message: Any) -> dict[str, Any]:
    channel = getattr(message, "channel", None)
    author = getattr(message, "author", None)
    ref = getattr(message, "reference", None)
    is_dm = channel.__class__.__name__ == "DMChannel" if channel is not None else False
    return {
        "channel_id": str(getattr(channel, "id", "") or ""),
        "user_id": str(getattr(author, "id", "") or ""),
        "message_id": str(getattr(message, "id", "") or ""),
        "referenced_message_id": (str(getattr(ref, "message_id", "") or "") or None) if ref else None,
        "mentioned_ids": [str(getattr(m, "id", "")) for m in (getattr(message, "mentions", None) or [])],
        "text": str(getattr(message, "content", "") or ""),
        "is_dm": is_dm,
        "is_group": bool(getattr(message, "guild", None) is None and not is_dm),
    }


def should_forward(fields: dict[str, Any], bot_user_id: str) -> bool:
    """Only a reply-with-mention in the intake channel is a command candidate."""
    if fields.get("channel_id") != INTAKE_CHANNEL_ID:
        return False
    if not fields.get("referenced_message_id"):
        return False
    return bot_user_id in set(fields.get("mentioned_ids") or [])


def _post(payload: dict[str, Any]) -> Optional[dict[str, Any]]:
    raw = json.dumps(payload).encode()
    signature = hmac.new(_hook_secret().encode(), raw, hashlib.sha256).hexdigest()
    request = urllib.request.Request(
        RECEPTIONIST_BASE_URL + "/discord/intake-command", data=raw,
        headers={"Content-Type": "application/json", "X-Hook-Signature": signature},
        method="POST")
    with urllib.request.urlopen(request, timeout=15) as response:
        if response.status != 200:
            logger.warning("intake-command returned HTTP %s", response.status)
            return None
        return json.loads(response.read())


async def maybe_handle_intake(adapter: Any, message: Any, bot_user_id: str) -> Optional[dict[str, Any]]:
    """Return the receptionist result dict if this message was an intake
    command (handled — caller must return WITHOUT invoking the LLM), else None."""
    fields = extract_fields(message)
    if not should_forward(fields, bot_user_id):
        return None
    try:
        result = _post(fields)
    except Exception:
        logger.warning("intake forward failed", exc_info=True)
        # Fail closed: swallow the command (never route it to the LLM) but do
        # not change any state; the receptionist is the only authority.
        return {"authorized": False, "reason": "forward_error", "readback": "", "llm": False, "handled": True}
    if not isinstance(result, dict):
        return {"authorized": False, "reason": "no_result", "readback": "", "llm": False, "handled": True}
    readback = result.get("readback") or ""
    if readback:
        try:
            await adapter.send(INTAKE_CHANNEL_ID, readback, reply_to=fields.get("message_id"))
        except Exception:
            logger.warning("intake read-back post failed", exc_info=True)
    result["handled"] = True
    return result
